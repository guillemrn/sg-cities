---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { portfolioAreas } from '../../data/portfolio';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { slug } = Astro.params;
const service = Astro.props.service ?? services.find((item) => item.slug === slug);
if (!service) throw new Error('Servicio no encontrado');
const area = portfolioAreas.find((a) => a.services.includes(service.slug));
---
<Layout title={`${service.title} | SG Cities`} description={service.description}>
  <Header current="portfolio" />
  <main>
    <section class="page-intro">
      <div class="container">
        <a class="text-link" href={area ? `/portafolio#${area.id}` : '/portafolio'}><Icon name="arrow-left" size={16} /> Volver al portafolio</a>
        <p class="eyebrow">{service.area}</p>
        <h1>{service.title}</h1>
        <p class="section-lead">{service.description}</p>
      </div>
    </section>
    <section class="service-detail">
      <div class="container service-detail__inner">
        <div>
          <h2 class="section-title">Cómo podemos abordarlo</h2>
          <p class="section-lead">Definimos el alcance a partir del contexto real del proyecto y de la información disponible.</p>
        </div>
        <div>
          <ul class="project__bullets">{service.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          <a class="button button--primary" href="/#contacto">Consultar este servicio <Icon name="arrow" /></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
