---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { services } from '../../data/services';
import { portfolioAreas } from '../../data/portfolio';
import { whatsappUrl } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const service = services.find((s) => s.slug === project.service);
const area = portfolioAreas.find((a) => a.services.includes(project.service));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: project.summary,
  image: `https://sgcities.com${project.cover}`,
  url: `https://sgcities.com/proyectos/${project.slug}/`,
  locationCreated: { '@type': 'Place', name: project.location },
  creator: { '@type': 'Organization', name: 'SG Cities', url: 'https://sgcities.com' },
  genre: service?.title,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://sgcities.com/' },
    { '@type': 'ListItem', position: 2, name: 'Portafolio', item: 'https://sgcities.com/portafolio/' },
    { '@type': 'ListItem', position: 3, name: project.name, item: `https://sgcities.com/proyectos/${project.slug}/` },
  ],
};
const heroFull = project.heroLayout === 'full' || !project.featureShots?.length;
const heroShots = heroFull ? [{ src: project.cover, alt: project.name, label: '' }] : project.featureShots!;
const others = projects.filter((x) => x.service === project.service && x.slug !== project.slug);
---
<Layout title={`${project.name} | Proyecto de SG Cities`} description={`${project.summary} ${project.location}, ${project.period.toLowerCase()}.`} image={project.cover.replace(/[^/]+\.webp$/, 'og.jpg')} imageAlt={`${project.name}, proyecto de SG Cities`} type="article" jsonLd={[schema, crumbs]}>
  <Header current="portfolio" overlay />
  <main>
    <!-- Portada del proyecto: misma regla que el hero del Home -->
    <section class={`feature-band case-hero ${heroFull ? 'case-hero--full' : ''}`} aria-labelledby="proyecto-titulo">
      <div class="feature-band__media">
        {heroShots.map((shot, i) => (
          <figure class={`feature-band__shot feature-band__shot--${i + 1} feature-band__shot--of-${heroShots.length}`} style={shot.src === project.cover ? `view-transition-name: proyecto-${project.slug}` : undefined}>
            <img src={shot.src} alt={shot.alt} fetchpriority={i === heroShots.length - 1 ? 'high' : undefined} />
            {shot.label && <figcaption>{shot.label}</figcaption>}
          </figure>
        ))}
      </div>
      <span class="feature-band__grid" aria-hidden="true"></span>
      <div class="container case-hero__back-wrap">
        <a class="case-hero__back" href={area ? `/portafolio#${area.id}` : '/portafolio'}><Icon name="arrow-left" size={16} /> Portafolio</a>
      </div>
      <div class="container feature-band__inner">
        <div class="feature-band__text">
          <p class="feature-band__kicker">Proyecto <span>·</span> {service?.title}</p>
          <h1 id="proyecto-titulo">{project.name}</h1>
          <p class="feature-band__meta">{project.period} <span>·</span> {project.location.replace(/, Jalisco$/, '')}</p>
          {project.stats.length > 0 && (
            <ul class="feature-band__stats">
              {project.stats.map((st) => <li><p class="featured__value">{st.value}</p><p>{st.label}</p></li>)}
            </ul>
          )}
        </div>
      </div>
    </section>

    <section class="case">
      <div class="container">
        <div class="case__body">
          <div class="case__text">
            {project.description.length ? project.description.map((para) => <p>{para}</p>) : <p>{project.summary}</p>}
            {project.credits?.map((c) => <p class="muted">{c}</p>)}
          </div>
          <aside class="case__aside">
            <ul class="chips">{project.tags.map((t) => <li>{t}</li>)}</ul>
            {project.video && (
              <figure class="case__video">
                <video src={project.video.src} poster={project.video.poster} controls muted playsinline preload="none"></video>
                <figcaption class="muted">{project.video.label}</figcaption>
              </figure>
            )}
          </aside>
        </div>
        <h2 class="subsection-title case__gallery-title">Galería <span class="case__count">{project.gallery.length} fotos</span></h2>
        <ul class="case__gallery" data-lightbox={project.name}>
          {project.gallery.map((img, i) => <li><a href={img.src} data-caption={img.alt} aria-label={`Ampliar foto ${i + 1}: ${img.alt}`}><img src={img.src} alt={img.alt} loading="lazy" /></a></li>)}
        </ul>
        {others.length > 0 && (
          <div class="case__others">
            <p class="project__label">Otros proyectos de {service?.title.toLowerCase()}</p>
            <ul class="project-cards__grid">
              {others.map((x) => (
                <li><a class="project-card" href={`/proyectos/${x.slug}`}><span class="project-card__media"><img src={x.cover} alt="" loading="lazy" style={`view-transition-name: proyecto-${x.slug}`} /></span><span class="project-card__body"><span class="project-card__meta">{x.period}</span><span class="project-card__name">{x.name}</span><span class="project-card__cta">Ver proyecto <Icon name="arrow" size={16} /></span></span></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band__inner">
        <div>
          <h2 class="section-title">¿Tienes un proyecto parecido?</h2>
          <p class="section-lead">Cuéntanos en qué etapa estás y te decimos por dónde empezar.</p>
        </div>
        <div class="button-row">
          <a class="button button--light" href={area ? `/?area=${area.id}#contacto` : "/#contacto"}>Hablar sobre un proyecto así</a>
          {whatsappUrl && <a class="button button--outline-light" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> WhatsApp</a>}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
