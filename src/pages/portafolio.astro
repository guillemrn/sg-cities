---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { portfolioAreas, featuredProjectSlug, hasProjects, servicesWithProjects } from '../data/portfolio';
import { services } from '../data/services';
import { whatsappUrl } from '../data/site';
import { projects, projectsFor } from '../data/projects';

// Solo áreas con proyectos reales; las demás vuelven solas al agregar proyectos.
const visibleAreas = portfolioAreas.filter(hasProjects);
const bySlug = (slug: string) => services.find((s) => s.slug === slug)!;
const featured = projects.find((x) => x.slug === featuredProjectSlug);
const featuredService = featured ? bySlug(featured.service) : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Portafolio de proyectos de SG Cities',
  url: 'https://sgcities.com/portafolio/',
  hasPart: projects.map((x) => ({ '@type': 'CreativeWork', name: x.name, url: `https://sgcities.com/proyectos/${x.slug}/` })),
};
---
<Layout title="Portafolio de proyectos | SG Cities" description="Proyectos de SG Cities en Guadalajara: edificación, estudios y factibilidades de infraestructura, planificación y gestión, y urbanización." jsonLd={schema}>
  <Header current="portfolio" />
  <main>
    <section class="page-intro">
      <div class="container">
        <a class="text-link" href="/"><Icon name="arrow-left" size={16} /> Volver al inicio</a>
        <h1>Portafolio de proyectos</h1>
        <p class="section-lead">Proyectos reales de SG Cities, con fotos de obra, datos y el proceso de cada uno.</p>
      </div>
      {featured && (
        <div class="container">
          <article class="featured">
            <img class="featured__img" src={featured.cover} alt={featured.name} />
            <div class="featured__body">
              <p class="marker marker--light"><span class="marker__num">★</span> Proyecto destacado · {featuredService?.title}</p>
              <h2>{featured.name}</h2>
              <p class="featured__meta">{featured.period} · {featured.location}</p>
              <p>{featured.summary}</p>
              {featured.stats.length > 0 && <ul class="featured__stats">{featured.stats.map((st) => <li><p class="featured__value">{st.value}</p><p>{st.label}</p></li>)}</ul>}
              <a class="button button--light" href={`/proyectos/${featured.slug}`}>Ver proyecto completo <Icon name="arrow" /></a>
            </div>
          </article>
        </div>
      )}
    </section>

    {visibleAreas.length > 1 && (
    <nav class="area-nav" aria-label="Áreas del portafolio">
      <div class="container area-nav__inner">
        <span class="muted">Ir a:</span>
        {visibleAreas.map((area) => <a href={`#${area.id}`}>{area.num} · {area.title}</a>)}
      </div>
    </nav>
    )}

    {visibleAreas.map((area) => (
      <section class="portfolio-area" id={area.id}>
        <div class="container">
          <div class="portfolio-area__head">
            <div>
              <p class="marker"><span class="marker__num">{area.num}</span> Área de trabajo</p>
              <h2 class="section-title">{area.title}</h2>
              <p class="section-lead">{area.summary}</p>
            </div>
            <p class="muted">{(() => { const n = servicesWithProjects(area).reduce((t, slug) => t + projectsFor(slug).length, 0); return n === 1 ? '1 proyecto' : `${n} proyectos`; })()}</p>
          </div>
          <div class="portfolio-area__items">
            {servicesWithProjects(area).map((slug, i) => {
              const s = bySlug(slug);
              const code = area.services.length > 1 ? `${area.num}.${area.services.indexOf(slug) + 1}` : area.num;
              const related = projectsFor(s.slug);
              const gallery = related.length ? related.map((x) => x.cover) : s.gallery?.length ? s.gallery : [area.image];
              return (
                <article class="project" id={s.slug}>
                  <div class="project__text">
                    <span class="project__code">{code}</span>
                    <h3>{s.title}</h3>
                    <p>{s.description}</p>
                    <ul class="project__bullets">{s.bullets.map((b) => <li>{b}</li>)}</ul>
                    {s.projects?.length ? (
                      <div class="project__list">
                        <p class="project__label">Proyectos realizados</p>
                        <ul>{s.projects.map((p) => <li>{p.name} · <span class="muted">{p.meta}</span></li>)}</ul>
                      </div>
                    ) : null}
                    {s.stats?.length ? <ul class="project__stats">{s.stats.map((st) => <li><p class="project__value">{st.value}</p><p>{st.label}</p></li>)}</ul> : null}
                    <a class="text-link" href={`/servicios/${s.slug}`}>Más sobre este servicio <Icon name="arrow" size={16} /></a>
                  </div>
                  {related.length ? (
                    <div class="project-cards">
                      <p class="project__label">Proyectos realizados</p>
                      <ul class="project-cards__grid">
                        {related.map((x) => (
                          <li>
                            <a class="project-card" href={`/proyectos/${x.slug}`}>
                              <span class="project-card__media"><img src={x.cover} alt="" loading="lazy" style={`view-transition-name: proyecto-${x.slug}`} /></span>
                              <span class="project-card__body">
                                <span class="project-card__meta">{x.period}</span>
                                <span class="project-card__name">{x.name}</span>
                                <span class="project-card__summary">{x.summary}</span>
                                <span class="project-card__cta">Ver proyecto <Icon name="arrow" size={16} /></span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : (
                    <div class={`project__gallery project__gallery--${Math.min(gallery.length, 3)}`}>
                      {gallery.slice(0, 3).map((src) => <img src={src} alt="" loading="lazy" />)}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      </section>
    ))}

    <section class="cta-band">
      <div class="container cta-band__inner">
        <div>
          <h2 class="section-title">¿Tienes un proyecto parecido?</h2>
          <p class="section-lead">Cuéntanos en qué etapa estás y te decimos por dónde empezar.</p>
        </div>
        <div class="button-row">
          <a class="button button--light" href="/#contacto">Enviar solicitud</a>
          {whatsappUrl && <a class="button button--outline-light" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> WhatsApp</a>}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
