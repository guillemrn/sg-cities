---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { portfolioAreas } from '../data/portfolio';
import { services } from '../data/services';
import { site, whatsappUrl, stats, audiences, clients } from '../data/site';

const titleOf = (slug: string) => services.find((s) => s.slug === slug)?.title ?? slug;
---
<Layout title="SG Cities: Planeación urbana, factibilidades, edificación y urbanización" description="Acompañamos proyectos urbanos, de infraestructura y de construcción: estudios y factibilidades, planificación y gestión, edificación y urbanización.">
  <Header current="about" />
  <main>
    <!-- 1. Portada -->
    <section class="hero" id="inicio">
      <div class="container hero__inner">
        <div class="hero__text">
          <p class="eyebrow">Planeación · Infraestructura · Edificación · Urbanización</p>
          <h1>Decisiones urbanas con dirección.</h1>
          <p class="hero__lead">Acompañamos proyectos urbanos, de infraestructura y de construcción desde el primer análisis hasta la obra terminada.</p>
          <div class="button-row">
            <a class="button button--primary" href="/portafolio">Ver nuestros proyectos <Icon name="arrow" /></a>
            <a class="button button--secondary" href="#contacto">Hablar sobre un proyecto</a>
          </div>
        </div>
        <div class="hero__media">
          <img src="/images/cta-image.jpg" alt="Vista aérea de una zona urbana" width="720" height="520" />
          <div class="hero__badge"><p class="hero__badge-title">Del análisis a la ejecución</p><p>Una ruta clara para cada etapa del proyecto.</p></div>
        </div>
      </div>
      {stats.length > 0 && (
        <div class="container">
          <ul class="stats">{stats.map((s) => <li><p class="stats__value">{s.value}</p><p class="stats__label">{s.label}</p></li>)}</ul>
        </div>
      )}
    </section>

    <!-- 2. Quiénes somos -->
    <section class="about" id="nosotros">
      <div class="container about__inner">
        <div class="about__heading">
          <p class="eyebrow">Quiénes somos</p>
          <h2 class="section-title">Una mirada integral para proyectos que importan.</h2>
        </div>
        <div class="about__body">
          <p class="about__text">SG Cities acompaña proyectos urbanos, inmobiliarios y de construcción con una lectura que conecta territorio, normativa, mercado y operación.</p>
          <details class="about__more">
            <summary>Conoce más sobre nosotros <Icon name="chevron" size={16} /></summary>
            <div class="about__more-body">
              <p>Reunimos derecho urbano y administrativo, estudios de factibilidad, análisis de mercado, planeación y gestión de obra alrededor de una misma decisión de proyecto. Así, cada etapa avanza con información clara y con un solo equipo que entiende el proyecto completo.</p>
            </div>
          </details>
        </div>
      </div>
      <div class="container audiences">
        <p class="subsection-title">Trabajamos con</p>
        <ul class="audiences__grid">{audiences.map((a) => <li><p class="audiences__title">{a.title}</p><p>{a.text}</p></li>)}</ul>
      </div>
      <div class="clients">
        <div class="container">
          <div class="clients__head"><p class="subsection-title">Algunos de nuestros clientes</p><p class="muted">Experiencia que se construye proyecto a proyecto.</p></div>
          <ul class="clients__grid">{clients.map((c) => <li><img src={c.logo} alt={`Logo de ${c.name}`} loading="lazy" /></li>)}</ul>
        </div>
      </div>
    </section>

    <!-- 3. Áreas de trabajo -->
    <section class="areas" id="areas">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Cómo podemos ayudarte</p>
            <h2 class="section-title">Cuatro áreas para ordenar el proyecto.</h2>
            <p class="section-lead">Cada área tiene su propia sección en el portafolio, con proyectos, fotos y resultados.</p>
          </div>
          <a class="button button--primary" href="/portafolio">Ver portafolio completo <Icon name="arrow" /></a>
        </div>
        <div class="areas__grid">
          {portfolioAreas.map((area) => (
            <article class="area-card">
              <img class="area-card__img" src={area.image} alt="" loading="lazy" />
              <div class="area-card__body">
                <p class="area-card__num">{area.num}</p>
                <h3>{area.title}</h3>
                <p>{area.summary}</p>
                {area.services.length > 1 && <ul class="chips">{area.services.map((slug) => <li>{titleOf(slug)}</li>)}</ul>}
                <a class="text-link" href={`/portafolio#${area.id}`}>Ver proyectos <Icon name="arrow" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Contacto -->
    <section class="contact" id="contacto">
      <div class="container contact__inner">
        <div class="contact__text">
          <p class="eyebrow eyebrow--light">Siguiente paso</p>
          <h2 class="section-title">Cuéntanos qué estás evaluando.</h2>
          <p class="contact__lead">Comparte el contexto de tu proyecto y te ayudamos a identificar el punto de partida.</p>
          <div class="contact__alt">
            {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"><span class="contact__icon"><Icon name="whatsapp" size={20} /></span>¿Prefieres WhatsApp? Escríbenos directo</a>}
            {site.email && <a href={`mailto:${site.email}`}><span class="contact__icon"><Icon name="mail" size={20} /></span>{site.email}</a>}
          </div>
        </div>
        <div class="contact__card"><ContactForm /></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
