---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { portfolioAreas, hasProjects } from '../data/portfolio';
import { services } from '../data/services';
import { site, whatsappUrl, stats, audiences, clients } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://sgcities.com/#organizacion',
  name: 'SG Cities',
  url: 'https://sgcities.com/',
  logo: 'https://sgcities.com/images/sg-cities-logo.svg',
  image: 'https://sgcities.com/images/og-sgcities.jpg',
  slogan: 'El valor de trascender la ciudad',
  description: 'Planeación urbana, estudios y factibilidades de infraestructura, planificación y gestión, edificación y urbanización en Guadalajara, Jalisco.',
  address: { '@type': 'PostalAddress', addressLocality: 'Guadalajara', addressRegion: 'Jalisco', addressCountry: 'MX' },
  areaServed: { '@type': 'State', name: 'Jalisco' },
  ...(site.email ? { email: site.email } : {}),
  sameAs: [site.facebook, site.linkedin, site.instagram].filter(Boolean),
  knowsAbout: services.map((s) => s.title),
};
const titleOf = (slug: string) => services.find((s) => s.slug === slug)?.title ?? slug;
---
<Layout title="SG Cities | Planeación urbana, factibilidades y obra en Guadalajara" description="Acompañamos proyectos urbanos, de infraestructura y de construcción en Jalisco: estudios y factibilidades, planificación y gestión, edificación y urbanización." jsonLd={schema}>
  <Header current="about" overlay />
  <main>
    <!-- 1. Portada: collage de obras reales + frase del cliente -->
    <section class="hero hero--collage" id="inicio" data-cad={site.cadCursor ? "" : undefined}>
      <div class="hero__collage" aria-hidden="true">
        <img class="hero__shot hero__shot--1" src="/portfolio/edificacion/living-segovia/cubo-de-luz-interior.webp" alt="" fetchpriority="high" />
        <img class="hero__shot hero__shot--2" src="/portfolio/edificacion/silly-billy-house/patio-acceso.webp" alt="" />
        <img class="hero__shot hero__shot--3" src="/portfolio/edificacion/silly-billy-house/fachada-terminada.webp" alt="" fetchpriority="high" />
        <span class="hero__veil"></span>
        <span class="hero__grid"></span>
      </div>
      <div class="container hero__inner">
        <div class="hero__text">
          <h1>El valor de trascender la&nbsp;ciudad</h1>
          <p class="hero__tagline">Planeación, infraestructura y obra <span>·</span> Guadalajara</p>
          <a class="button button--light" href="/portafolio">Ver proyectos <Icon name="arrow" /></a>
        </div>
      </div>
      <p class="hero__credit">En la imagen: <a href="/proyectos/living-segovia">Living Segovia</a> · <a href="/proyectos/silly-billy-house">Silly Billy House</a></p>
      <ul class="hero__social" aria-label="Redes sociales">
        {whatsappUrl && <li><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><Icon name="whatsapp" size={20} /></a></li>}
        {site.facebook && <li><a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><Icon name="facebook" size={20} /></a></li>}
        {site.linkedin && <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a></li>}
        {site.instagram && <li><a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><Icon name="instagram" size={20} /></a></li>}
      </ul>
      {stats.length > 0 && (
        <div class="container">
          <ul class="stats">{stats.map((s) => <li><p class="stats__value">{s.value}</p><p class="stats__label">{s.label}</p></li>)}</ul>
        </div>
      )}
    </section>

    <!-- 2. Quiénes somos -->
    <section class="about" id="nosotros">
      <div class="container about__inner">
        <div class="about__heading">
          <p class="marker"><span class="marker__num">01</span> Quiénes somos</p>
          <h2 class="section-title">Una mirada integral para proyectos que importan.</h2>
        </div>
        <div class="about__body">
          <p class="about__text">SG Cities acompaña proyectos urbanos, inmobiliarios y de construcción con una lectura que conecta territorio, normativa, mercado y operación.</p>
          <details class="about__more">
            <summary>Conoce más sobre nosotros <Icon name="chevron" size={16} /></summary>
            <div class="about__more-body">
              <p>Reunimos derecho urbano y administrativo, estudios de factibilidad, análisis de mercado, planeación y gestión de obra alrededor de una misma decisión de proyecto. Así, cada etapa avanza con información clara y con un solo equipo que entiende el proyecto completo.</p>
            </div>
          </details>
        </div>
      </div>
      <div class="container audiences">
        <p class="subsection-title">Trabajamos con</p>
        <ul class="audiences__grid">{audiences.map((a) => <li><p class="audiences__title">{a.title}</p><p>{a.text}</p></li>)}</ul>
      </div>
      <div class="clients">
        <div class="container">
          <div class="clients__head"><p class="subsection-title">Algunos de nuestros clientes</p><p class="muted">Experiencia que se construye proyecto a proyecto.</p></div>
          <ul class="clients__grid">{clients.map((c) => <li><img src={c.logo} alt={`Logo de ${c.name}`} loading="lazy" /></li>)}</ul>
        </div>
      </div>
    </section>

    <!-- 3. Áreas de trabajo -->
    <section class="areas" id="areas">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="marker"><span class="marker__num">02</span> Áreas de trabajo</p>
            <h2 class="section-title">Cuatro áreas para ordenar el proyecto.</h2>
            <p class="section-lead">Conoce en el portafolio algunos de los proyectos que hemos realizado.</p>
          </div>
          <a class="button button--primary" href="/portafolio">Ver portafolio completo <Icon name="arrow" /></a>
        </div>
        <ol class="area-list">
          {portfolioAreas.map((area) => (
            <li class={area.image ? "area-row" : "area-row area-row--text"}>
              <span class="area-row__num" aria-hidden="true">{area.num}</span>
              <div class="area-row__body">
                <h3>{hasProjects(area) ? <a href={`/portafolio#${area.id}`}>{area.title}</a> : area.title}</h3>
                <p>{area.summary}</p>
                {area.services.length > 1 && <ul class="tags">{area.services.map((slug) => <li>{titleOf(slug)}</li>)}</ul>}
              </div>
              {area.image && <img class="area-row__img" src={area.image} alt="" loading="lazy" />}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. Contacto -->
    <section class="contact" id="contacto">
      <div class="container contact__inner">
        <div class="contact__text">
          <p class="marker marker--light"><span class="marker__num">03</span> Contacto</p>
          <h2 class="section-title">Cuéntanos qué estás evaluando.</h2>
          <p class="contact__lead">Comparte el contexto de tu proyecto y te ayudamos a identificar el punto de partida.</p>
          <div class="contact__alt">
            {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"><span class="contact__icon"><Icon name="whatsapp" size={20} /></span>¿Prefieres WhatsApp? Escríbenos directo</a>}
            {site.email && <a href={`mailto:${site.email}`} data-copy={site.email}><span class="contact__icon"><Icon name="mail" size={20} /></span>{site.email}</a>}
          </div>
        </div>
        <div class="contact__card"><ContactForm /></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
