---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';

interface Props { current?: string; }
const { current = '' } = Astro.props;
const links = [
  { href: '/#nosotros', label: 'Nosotros', id: 'about' },
  { href: '/#areas', label: 'Áreas de trabajo', id: 'areas' },
  { href: '/portafolio', label: 'Portafolio', id: 'portfolio' },
  { href: '/#contacto', label: 'Contacto', id: 'contact' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/"><img src="/images/sg-cities-logo.svg" alt="SG Cities" width="160" height="40" /></a>
    <button class="hamburger hamburger--slider" type="button" aria-label="Abrir menú" aria-controls="navigation" aria-expanded="false"><span class="hamburger-box"><span class="hamburger-inner"></span></span></button>
    <nav id="navigation" class="site-nav" aria-label="Navegación principal">
      <p class="site-nav__marker marker marker--light" aria-hidden="true"><span class="marker__num">—</span> Menú</p>
      <ul>
        {links.map((link, i) => (
          <li>
            <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
              <span class="site-nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="site-nav__label">{link.label}</span>
              <span class="site-nav__arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
        {whatsappUrl && <li class="site-nav__pill"><a class="pill-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />WhatsApp</a></li>}
      </ul>
      <div class="site-nav__foot">
        {whatsappUrl && <a class="button button--light" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Escríbenos por WhatsApp</a>}
        {site.email && <a class="site-nav__mail" href={`mailto:${site.email}`}>{site.email}</a>}
        <p class="site-nav__place">SG Cities <span>/</span> {site.location}</p>
      </div>
    </nav>
  </div>
</header>
