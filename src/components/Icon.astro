---
interface Props { name: 'whatsapp' | 'arrow' | 'arrow-left' | 'mail' | 'chevron' | 'facebook' | 'linkedin'; size?: number; }
const { name, size = 18 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'whatsapp' && <><path d="M3 21l1.6-4.8A8.5 8.5 0 1 1 7.8 19.4L3 21z" /><path d="M9 9.5c.3 1.8 1.7 3.6 3.6 4.4l1.2-1.1 2 .8v1.6c-3.8.5-7.6-3.2-7.1-7.1h1.6l.8 2z" /></>}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 18l-6-6 6-6" />}
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'facebook' && <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z" />}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></>}
</svg>
