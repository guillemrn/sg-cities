---
import { portfolioAreas } from '../data/portfolio';
---
<form class="contact-form js-make-form" name="contacto" data-success-url="/gracias" novalidate>
  <label class="field">
    <span class="field__label">Nombre</span>
    <input type="text" name="nombre" autocomplete="name" required aria-describedby="err-nombre" />
    <span class="field-error" id="err-nombre" hidden>Escribe tu nombre.</span>
  </label>
  <label class="field">
    <span class="field__label">Correo electrónico</span>
    <input type="email" name="email" autocomplete="email" inputmode="email" required aria-describedby="err-email" />
    <span class="field-error" id="err-email" hidden>Revisa tu correo, parece incompleto.</span>
  </label>
  <label class="field contact-form__full">
    <span class="field__label">Área de interés</span>
    <select name="area">
      <option value="">Aún no lo sé</option>
      {portfolioAreas.map((area) => <option value={area.title} data-id={area.id}>{area.title}</option>)}
    </select>
  </label>
  <label class="field contact-form__full">
    <span class="field__label">¿Qué proyecto tienes en mente?</span>
    <textarea name="mensaje" rows="4" required aria-describedby="err-mensaje" placeholder="Unas líneas bastan: qué es, dónde está y en qué etapa va."></textarea>
    <span class="field-error" id="err-mensaje" hidden>Cuéntanos aunque sea en una línea.</span>
  </label>

  <input class="hp-field" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="origen" value="" />
  <input type="hidden" name="t" value="" />

  <div class="contact-form__submit contact-form__full">
    <button class="button button--primary" type="submit"><span class="button__text">Enviar solicitud</span></button>
    <p class="contact-form__legal">Tus datos solo se usan para responderte. <a href="/politica-de-privacidad">Aviso de privacidad</a></p>
  </div>
  <p class="form-status contact-form__full" role="status" aria-live="polite"></p>
</form>
